# --- Database (Supabase Postgres) ---------------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used only by `prisma migrate` / `prisma db push`.
# Prisma's migration engine cannot run through PgBouncer.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Domain sales: namebio.vps4.auctionhacker.com ------------------------
# Optional override — defaults to the live host if unset. Only /namebio/sales/search
# is reliable on this host as of 2026-07-21; data stops at 2026-06-30 (stalled backfill).
NAMEBIO_AUCTIONHACKER_BASE_URL="https://namebio.vps4.auctionhacker.com"

# Optional manual-CSV fallback path (columns: domain,price,currency,saleDate,marketplace,sourceUrl)
# DOMAIN_SALES_CSV_PATH="./data/domain-sales-manual.csv"

# --- Funding: PredictLeads (free tier — 100 credits/month) ---------------
# Leave both unset to skip PredictLeads entirely and run RSS-only (TechCrunch/
# VentureBeat/Google News still work with zero config).
PREDICTLEADS_API_TOKEN=""
PREDICTLEADS_API_KEY=""
# PREDICTLEADS_BASE_URL="https://predictleads.com/api/v3"
# PREDICTLEADS_CREDITS_CAP="100"

# --- Optional RSS feed overrides (defaults already point at the real feeds) ---
# TECHCRUNCH_FEED_URL="https://techcrunch.com/category/venture/feed/"
# VENTUREBEAT_FEED_URL="https://venturebeat.com/category/ai/feed"
# GOOGLE_NEWS_FEED_URL="https://news.google.com/rss/search?q=...&hl=en-US&gl=US&ceid=US:en"

# --- Payload CMS (article content — see payload-cms/) --------------------
# Base URL of the deployed Payload instance. Public reads (blog pages, /api/articles)
# work without a key; PAYLOAD_API_KEY is only needed to write (scripts/build-report.ts).
PAYLOAD_API_URL="https://cms.h.namekart.com"
# Generate in the Payload admin: Users > your user > API Key.
PAYLOAD_API_KEY=""

